# ExaminerAI - Environment Configuration

# REQUIRED: Primary Groq API key for fast AI question parsing & grading
# Obtain a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: Fallback OpenRouter API key (multi-model fallback chain)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_TEXT=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_VISION=google/gemma-2-9b-it:free

# Groq model choices (defaults shown - override if needed)
GROQ_MODEL_PARSING=llama-3.3-70b-versatile
GROQ_MODEL_VISION=llama-3.2-11b-vision-preview

# OPTIONAL: Local Ollama URL for GLM-OCR (scanned PDF / image OCR)
# Defaults to http://localhost:11434 if not set
# Install: https://ollama.ai -> ollama pull glm-ocr:latest
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_OCR_MODEL=glm-ocr:latest
